# ==============================================================================
# ClaimGuard Phase 1 Environment Configuration (Placeholders only)
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
# ==============================================================================

# Application environment: development | test | production
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=claimguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://claimguard:your_secure_postgres_password_here@postgres:5432/claimguard

# FalkorDB Configuration
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=claimguard

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=your_minio_access_key_here
S3_SECRET_KEY=your_minio_secret_key_here
S3_BUCKET_NAME=claimguard-documents
S3_REGION=us-east-1
S3_USE_SSL=false
PRESIGNED_URL_EXPIRE_SECONDS=300

# Security and JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long_placeholder
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg","text/plain","message/rfc822"]

# CORS Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_EXTRACT_PER_MINUTE=10

# ==============================================================================
# Phase 2: NVIDIA Nemotron Inference (Nebius Token Factory)
# ==============================================================================
# Feature flag to enable AI inference and extraction workflow (default: false)
INFERENCE_ENABLED=false

# Nebius Token Factory API Key (Never commit this to version control!)
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory Base URL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model Tiers
NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra

# Inference & Ingestion Constraints
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_MAX_INPUT_CHARS=32000
LLM_MAX_CONCURRENCY=5
EXTRACTION_MAX_PAGES=50
EXTRACTION_MAX_TEXT_CHARS=100000
ALLOW_TIER_ESCALATION=false
